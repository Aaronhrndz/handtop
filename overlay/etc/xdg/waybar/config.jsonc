// RG35XX H panel: bottom taskbar, sized for 640x480. Per-user override: ~/.config/waybar/
{
  "layer": "top",
  "position": "bottom",
  "height": 30,
  "spacing": 4,
  "modules-left": ["custom/apps", "wlr/taskbar"],
  "modules-right": ["tray", "pulseaudio", "network", "battery", "clock", "custom/power"],

  "custom/apps":  { "format": "☰ Apps", "tooltip": false, "on-click": "rg35xxh-drawer" },
  "custom/power": { "format": "⏻", "tooltip": false, "on-click": "rg35xxh-power-menu" },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 20,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize"
  },
  "tray": { "icon-size": 18, "spacing": 6 },
  "pulseaudio": {
    "format": "♪ {volume}%",
    "format-muted": "♪ mute",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "LAN",
    "format-disconnected": "offline",
    "tooltip-format": "{essid} {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "bat": "battery",
    "interval": 30,
    "states": { "warning": 20, "critical": 10 },
    "format": "{capacity}%",
    "format-charging": "{capacity}%+",
    "tooltip-format": "{timeTo}"
  },
  "clock": { "format": "{:%H:%M}", "tooltip-format": "{:%Y-%m-%d %a}" }
}
