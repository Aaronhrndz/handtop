#!/usr/bin/python3
"""Screen layout when an HDMI monitor is connected.

  rg35xxh-display set monitor|extend|mirror   choose and apply a mode (remembered)
  rg35xxh-display apply                       re-apply the saved mode (kanshi runs this on hotplug)
  rg35xxh-display osk on|off                  monitor mode: wake the handheld screen for the keyboard
  rg35xxh-display status                      print mode, docked yes/no

Modes (only matter while HDMI is connected):
  monitor  handheld screen off; it turns on as a keyboard panel when X shows the keyboard
  extend   two screens, handheld to the right of the monitor
  mirror   monitor switches to 640x480 and shows the same picture as the handheld
"""
import json
import os
import subprocess
import sys

INTERNAL = "DSI-1"
MODES = ("monitor", "extend", "mirror")
STATE = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "rg35xxh", "display-mode")
OSK_FLAG = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "rg35xxh-osk-panel")
FAR = "4000,0"   # not adjacent to the monitor, so the pointer cannot wander onto it


def mode():
    try:
        with open(STATE) as f:
            m = f.read().strip()
        return m if m in MODES else "monitor"
    except OSError:
        return "monitor"


def outputs():
    out = subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, check=True).stdout
    return {o["name"]: o for o in json.loads(out)}


def external(outs):
    return next((o for n, o in outs.items() if n != INTERNAL), None)


def randr(*args):
    subprocess.run(["wlr-randr", *args], check=False)


def notify(text):
    subprocess.run(["notify-send", "-t", "2500", "Display", text], check=False)


def apply(osk=None):
    outs = outputs()
    ext = external(outs)
    if ext is None:            # handheld only: kanshi already enabled the panel
        randr("--output", INTERNAL, "--on", "--mode", "640x480", "--pos", "0,0")
        return
    name = ext["name"]
    m = mode()
    if osk is None:
        osk = os.path.exists(OSK_FLAG)
    if m == "monitor":
        randr("--output", name, "--on", "--preferred", "--pos", "0,0")
        if osk:
            randr("--output", INTERNAL, "--on", "--pos", FAR)
        else:
            randr("--output", INTERNAL, "--off")
    elif m == "extend":
        randr("--output", name, "--on", "--preferred", "--pos", "0,0")
        width = next((md["width"] for md in outputs()[name]["modes"] if md.get("current")), 1920)
        randr("--output", INTERNAL, "--on", "--pos", f"{width},0")
    else:  # mirror: same 640x480 area on both
        randr("--output", name, "--on", "--mode", "640x480", "--pos", "0,0")
        randr("--output", INTERNAL, "--on", "--pos", "0,0")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "apply"
    if cmd == "set" and len(argv) > 2 and argv[2] in MODES:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE, "w") as f:
            f.write(argv[2] + "\n")
        apply()
        notify({"monitor": "Monitor only", "extend": "Extended screens", "mirror": "Mirrored"}[argv[2]]
               + ("" if external(outputs()) else " (applies when HDMI is connected)"))
    elif cmd == "apply":
        apply()
    elif cmd == "osk" and len(argv) > 2 and argv[2] in ("on", "off"):
        if argv[2] == "on":
            open(OSK_FLAG, "w").close()
        elif os.path.exists(OSK_FLAG):
            os.unlink(OSK_FLAG)
        if mode() == "monitor" and external(outputs()):
            apply(osk=argv[2] == "on")
    elif cmd == "status":
        print(mode(), "docked" if external(outputs()) else "handheld")
    else:
        print(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
