#!/bin/bash
# Write a diagnostic log to the boot partition (readable from Windows): logs/boot-<N>.txt,
# keeping the last 5. Runs 60 s after boot and again when the desktop session is up.
set -uo pipefail
dir=/boot/firmware/logs
mkdir -p "$dir" || exit 0
n_file=/var/lib/rg35xxh/boot-count
mkdir -p /var/lib/rg35xxh
if [ "${1:-}" != "--update" ] || [ ! -f "$n_file" ]; then
  n=$(( $(cat "$n_file" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$n_file"
else
  n=$(cat "$n_file")
fi
out="$dir/boot-$(printf '%04d' "$n").txt"
{
  echo "== RG35XX H boot log #$n  $(date '+%Y-%m-%d %H:%M:%S %Z')  up $(cut -d' ' -f1 /proc/uptime)s"
  echo "== kernel: $(uname -a)"
  echo; echo "== failed units"; systemctl --failed --no-legend --plain
  echo; echo "== network"; ip -brief addr; nmcli -t -f DEVICE,STATE,CONNECTION device 2>/dev/null; rfkill list 2>/dev/null
  echo; echo "== input devices"; grep -E '^(N|H):' /proc/bus/input/devices
  echo; echo "== displays"; for s in /sys/class/drm/card*-*/status; do echo "$s: $(cat "$s")"; done
  echo; echo "== battery"; cat /sys/class/power_supply/*/uevent 2>/dev/null | grep -E 'NAME|STATUS|CAPACITY=' 
  echo; echo "== memory"; free -m
  echo; echo "== storage"; df -h / /boot/firmware
  echo; echo "== desktop session logs"
  for f in /home/*/.local/state/labwc.log /home/*/.local/state/session/*.log; do
    [ -f "$f" ] && { echo "-- $f"; tail -n 30 "$f"; }
  done
  echo; echo "== journal (warnings and errors)"; journalctl -b -p warning --no-pager -q | tail -n 300
  echo; echo "== kernel messages"; dmesg | tail -n 300
} > "$out" 2>&1
# Keep the newest 5 logs.
ls -1 "$dir"/boot-*.txt 2>/dev/null | sort | head -n -5 | xargs -r rm -f --
sync
