#!/bin/bash
# 2 GB swap file on the SD card, used only after the zram swap (priority 100) is full.
# Created on first boot (after the root partition has been grown), enabled on every boot.
set -euo pipefail
FILE=/swapfile
SIZE_MB="${SIZE_MB:-2048}"
PRIO=10

if [ ! -f "$FILE" ]; then
  avail_mb=$(df --output=avail -m / | tail -1 | tr -d ' ')
  if [ "$avail_mb" -lt $((SIZE_MB + 2048)) ]; then
    echo "rg35xxh-swapfile: only ${avail_mb} MB free, not creating ${SIZE_MB} MB swap file"
    exit 0
  fi
  echo "rg35xxh-swapfile: creating ${SIZE_MB} MB $FILE"
  fallocate -l "${SIZE_MB}M" "$FILE.tmp" || dd if=/dev/zero of="$FILE.tmp" bs=1M count="$SIZE_MB" status=none
  chmod 600 "$FILE.tmp"
  mkswap -L rg35xxh-swap "$FILE.tmp" >/dev/null
  mv "$FILE.tmp" "$FILE"
fi
if ! grep -q "^$FILE " /proc/swaps; then
  swapon -p "$PRIO" "$FILE"
  echo "rg35xxh-swapfile: enabled $FILE (priority $PRIO)"
fi
