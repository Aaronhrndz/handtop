#!/bin/bash
# First boot: grow the root partition (last on the card) and its ext4 filesystem to fill the SD card.
set -euo pipefail
src="$(findmnt -n -o SOURCE /)"
disk="/dev/$(lsblk -n -o PKNAME "$src")"
part="$(cat "/sys/class/block/$(basename "$src")/partition")"
echo "rg35xxh-resize-root: $src (partition $part of $disk)"
growpart "$disk" "$part" || [ $? -eq 1 ]   # exit 1 = already at maximum size
resize2fs "$src"
mkdir -p /var/lib/rg35xxh && touch /var/lib/rg35xxh/root-resized
echo "rg35xxh-resize-root: done ($(df -h / | awk 'NR==2 {print $2}'))"
